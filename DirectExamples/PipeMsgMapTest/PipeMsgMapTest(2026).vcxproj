      <AdditionalLibraryDirectories>..\..\..\lib\$(Platform)\$(Configuration);..\..\..\lib\$(Platform);..\..\..\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <!-- NOTE: Targetcore is NOT delay-loaded here. This project references an
           imported *data* symbol (P2PeerHub::P2PeerMsgMap, pulled in by
           BEGIN_P2PeerMsg_MAP), and the linker cannot delay-load a DLL from
           which a data symbol is imported (LNK1194). So it loads normally and
