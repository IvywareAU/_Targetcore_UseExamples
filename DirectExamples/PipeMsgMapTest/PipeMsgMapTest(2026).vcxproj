  <!-- ===== Debug | x64 ===== -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>WIN32;_WINDOWS;_DEBUG;_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <RuntimeTypeInfo>true</RuntimeTypeInfo>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>stdafx.h</PrecompiledHeaderFile>
      <WarningLevel>Level3</WarningLevel>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <AdditionalIncludeDirectories>..\..\..\Msgcore;..\..\..\Targetcore;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <ProgramDatabaseFile>$(OutDir)$(TargetName).pdb</ProgramDatabaseFile>
      <AdditionalDependencies>Msgcore.lib;Targetcore.lib;MsWsock.lib;ws2_32.lib;comsuppwd.lib;delayimp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>..\..\..\lib\$(Platform)\$(Configuration);..\..\..\lib\$(Platform);..\..\..\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <!-- NOTE: Targetcore is NOT delay-loaded here. This project references an
           imported *data* symbol (P2PeerHub::P2PeerMsgMap, pulled in by
           BEGIN_P2PeerMsg_MAP), and the linker cannot delay-load a DLL from
           which a data symbol is imported (LNK1194). So it loads normally and
           the post-build step copies the DLL next to the exe. -->
      <ImageHasSafeExceptionHandlers>false</ImageHasSafeExceptionHandlers>
    </Link>
    <PostBuildEvent>
      <!-- Stage the kernel from the shared deploy tree, bin\<Config>64, which is
           where IW_CustomBuildStep.bat puts both DLLs for both configurations.
           The old sources cannot survive this move: "..\..\..\Msgcore\$(OutDir)"
           and "..\..\..\Targetcore\$(OutDir)" concatenated a RELATIVE $(OutDir)
           onto a sibling repository's path, which the shared output root makes
           absolute and therefore nonsense, and $(WDMSCS_DEBUG) names the Debug
           folder even in a Release build. The closing check stays: xcopy exits 0
           on a wildcard miss, so a missing DLL is silent here and the exe then
           dies at startup with 0xC06D007E, Targetcore being delay-loaded. -->
      <Command>xcopy /Y "..\..\..\bin\$(Configuration)64\Msgcore.dll" "$(OutDir)"
if exist "..\..\..\bin\$(Configuration)64\Msgcore.pdb" xcopy /Y "..\..\..\bin\$(Configuration)64\Msgcore.pdb" "$(OutDir)"
xcopy /Y "..\..\..\bin\$(Configuration)64\Targetcore.dll" "$(OutDir)"
if exist "..\..\..\bin\$(Configuration)64\Targetcore.pdb" xcopy /Y "..\..\..\bin\$(Configuration)64\Targetcore.pdb" "$(OutDir)"
if not exist "$(OutDir)Targetcore.dll" echo POSTBUILD ERROR: Targetcore.dll not found in "..\..\..\bin\$(Configuration)64" -- build Targetcore first. &amp;&amp; exit /b 1</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>

